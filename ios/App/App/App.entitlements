<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links: a link to the site opens the app once the site serves
	     /.well-known/apple-app-site-association (lib/store.js, needs APPLE_TEAM_ID).
	     Xcode turns this on in the App ID when the team signs the app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.asilummagazine.com</string>
		<string>webcredentials:www.asilummagazine.com</string>
	</array>
</dict>
</plist>
