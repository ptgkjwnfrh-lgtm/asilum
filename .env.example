# ASILUM environment — copy to .env.local and fill in. Never commit real keys.
# Local development can run without these (in-memory store, demo catalog).
# Production requires the identity and database values described below.

# ---- Supabase (preferred backend: auth + Postgres + storage) ----
# Client-safe (exposed to the browser by Next.js — anon key only, never service role):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local/staging load-test fixtures only. Production builds always suppress them.
NEXT_PUBLIC_ENABLE_DEMO_SOCIAL=0
# Runtime Postgres connection string. Production requires the least-privilege
# asilum_app role created by schema v11; use its transaction-pooler URL here.
DATABASE_URL=
DATABASE_EXPECTED_ROLE=asilum_app
# Serverless deployments should use Supabase's transaction pooler URL. Keep the
# application-side pool small because each warm instance creates its own pool.
DATABASE_POOL_MAX=5
# One-time local role setup only. Never deploy or commit these values; remove
# them from .env.local after `npm run db:configure-role` succeeds.
DATABASE_ADMIN_URL=
DATABASE_APP_PASSWORD=
# Local Postgres integration tests only; production rejects "disable".
DATABASE_SSL_MODE=verify-full
# TLS trust anchor for DATABASE_URL — inline PEM or a path. Supabase chains to
# its own root CA (not in node's trust store): use the checked-in copy below.
# Verify its SHA256 fingerprint against the dashboard's SSL cert download:
# 80:70:25:AD:50:D4:ED:21:9D:2C:9C:7D:29:9C:00:4F:82:4E:B0:0C:F7:F6:5A:FE:F6:07:D0:7B:72:E6:CA:FA
DATABASE_SSL_CA=supabase/prod-ca-2021.crt

# ---- eBay Browse API (the one LIVE source adapter — lib/ingest/adapters/ebayAdapter.js) ----
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_PARTNERSHIP_APPROVED=0
# EBAY_ENV=PRODUCTION for live listings (defaults to SANDBOX)
EBAY_ENV=
# Paid-adapter hard ceilings. Each request needs a signed device cookie and
# consumes both budgets; the global ceiling protects upstream API spend.
EBAY_USER_MINUTE_LIMIT=30
EBAY_GLOBAL_MINUTE_LIMIT=300

# ---- Admin/moderation API (/api/admin — disabled until set, 16+ chars) ----
ADMIN_TOKEN=

# ---- AI search seam (lib/ai/search-adapter.js) — local rule/tag logic when
#      false/unset; flipping true without a wired provider reports honestly ----
AI_SEARCH_ENABLED=

# ---- Pinterest OAuth (future: moodboard inspiration import, real OAuth only) ----
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ---- Shopify Storefront API (future: independent designer stores) ----
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# Merchant-owned WooCommerce Store API. Never set approval without permission.
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_STORE_APPROVED=0

# Exact comma-separated HTTPS hostnames the ingestion route may contact.
INGEST_ALLOWED_HOSTS=merchant.example,api.merchant.example
INGEST_TOKEN=
OFFICIAL_API_KEY=

# ---- Alpha Learning Brain providers (future; see lib/ALPHA-BRAIN.md) ----
# Embeddings (lib/embeddings v1 — text/visual vectors):
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=
# Vision (lib/vision — moodboard image analysis + fit-pic analyzer):
VISION_PROVIDER=
VISION_API_KEY=

# Random secret (32+ characters) used to sign HttpOnly anonymous-device cookies.
DEVICE_COOKIE_SECRET=replace-with-at-least-32-random-characters

# ---- Asterisk AI adapter (lib/ai/adapter.js — Day 9 seam, Day 10 provider) ----
# ALL disabled by default; the app runs fully and honestly with none set.
# A feature calls a real model only when AI_FEATURES_ENABLED=true AND
# AI_PROVIDER is set AND AI_API_KEY exists AND the per-feature flag is true.
# The anthropic provider is IMPLEMENTED (Day 10). To enable:
#   AI_PROVIDER=anthropic
#   AI_MODEL_NAME=claude-haiku-4-5   (cheap/fast; claude-sonnet-4-6 or
#                                     claude-opus-4-8 for higher quality)
#   AI_API_KEY=<server-only Anthropic key — never NEXT_PUBLIC>
AI_FEATURES_ENABLED=false
AI_PROVIDER=none
AI_MODEL_NAME=
AI_API_KEY=
AI_MOOD_BOARD_ENABLED=false
AI_STYLIST_ENABLED=false
# Asterisk dual-tag audit (lib/asterisk/tagAudit.js). Off = honest local rules.
AI_TAG_AUDIT_ENABLED=false
# Model-assisted research drafting (lib/asterisk/research.js). Off = proposals
# are hand-submitted via admin asterisk.research.propose; nothing is faked.
AI_RESEARCH_ENABLED=false
# Unknown-query demand aggregation (lib/asterisk/unknownQueries.js). Off =
# unresolved queries are answered honestly but not recorded. Enable once the
# owner sets the retention period (docs/DATA-INVENTORY.md, DRAFT 180 days).
ASTERISK_UNKNOWN_QUERIES_ENABLED=false
# Hard ceilings for paid model calls (per feature). User-derived moodboard and
# stylist requests also require explicit aiConsent=true in the request.
AI_USER_HOURLY_LIMIT=12
AI_GLOBAL_HOURLY_LIMIT=200
# Comma-separated CDN hostnames whose product images may be downloaded for
# merchant-stated color verification (for example: cdn.partner.example).
INGEST_IMAGE_ALLOWED_HOSTS=
