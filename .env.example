# ASILUM environment — copy to .env.local and fill in. Never commit real keys.
# The app runs fully without any of these (in-memory store, demo catalog);
# nothing crashes when they're missing.

# ---- Supabase (preferred backend: auth + Postgres + storage) ----
# Client-safe (exposed to the browser by Next.js — anon key only, never service role):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_:
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Supabase → Project Settings → Database).
# lib/db/index.js uses this today; without it the app uses the in-memory store.
DATABASE_URL=

# ---- eBay Browse API (the one LIVE source adapter — lib/ingest/adapters/ebayAdapter.js) ----
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_ENV=PRODUCTION for live listings (defaults to SANDBOX)
EBAY_ENV=

# ---- Future source adapters (lib/ingest/adapters/ — DISABLED until official
#      API keys / partner approval exist; they never scrape, never fake) ----
DEPOP_API_KEY=
GRAILED_API_KEY=
SSENSE_FEED_URL=
SSENSE_API_KEY=
THEREALREAL_FEED_URL=
THEREALREAL_API_KEY=

# ---- Admin/moderation API (/api/admin — disabled until set, 16+ chars) ----
ADMIN_TOKEN=

# ---- AI search seam (lib/ai/search-adapter.js) — local rule/tag logic when
#      false/unset; flipping true without a wired provider reports honestly ----
AI_SEARCH_ENABLED=

# ---- Pinterest OAuth (future: moodboard inspiration import, real OAuth only) ----
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ---- Shopify Storefront API (future: independent designer stores) ----
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ---- Stripe (future: checkout — do NOT build checkout yet, see CONSTITUTION.md) ----
# Publishable key is client-safe; secret key is server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# ---- Independent designer feeds (future: per-designer product ingest) ----
# No adapter exists yet; when one lands it goes in lib/ingest/ next to ebay.js.
DESIGNER_FEED_URL=

# ---- Spotify (future: opt-in music-taste signal → lib/music-mapping) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Alpha Learning Brain providers (future; see lib/ALPHA-BRAIN.md) ----
# Embeddings (lib/embeddings v1 — text/visual vectors):
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=
# Vision (lib/vision — moodboard image analysis + fit-pic analyzer):
VISION_PROVIDER=
VISION_API_KEY=

# Random secret (32+ characters) used to sign HttpOnly anonymous-device cookies.
DEVICE_COOKIE_SECRET=replace-with-at-least-32-random-characters
