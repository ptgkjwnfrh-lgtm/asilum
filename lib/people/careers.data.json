    {"id":"tom-ford","kind":"designer","name":"Tom Ford","aliases":["Thomas Carlyle Ford"],"summary":{"text":"American designer and filmmaker who rebuilt Gucci in the 1990s, ran YSL Rive Gauche, then founded his own luxury house in 2005.","sourceIds":["s1","s2"]},"facts":[{"key":"nationality","claim":{"text":"American.","sourceIds":["s2"]}},{"key":"born","claim":{"text":"Born 27 August 1961 in Austin, Texas.","sourceIds":["s2"]}},{"key":"signature","claim":{"text":"Credited with taking Gucci from about $230m in sales in 1994 to nearly $3bn by 2003.","sourceIds":["s1"]}}]},
    {"id":"hedi-slimane","kind":"designer","name":"Hedi Slimane","aliases":[],"summary":{"text":"French designer-photographer known for skinny tailoring, who led Dior Homme, renamed Saint Laurent's ready-to-wear, and ran Celine for nearly seven years.","sourceIds":["s9","s13"]},"facts":[{"key":"nationality","claim":{"text":"French.","sourceIds":["s65"]}},{"key":"born","claim":{"text":"Born 5 July 1968 in Paris.","sourceIds":["s65"]}},{"key":"signature","claim":{"text":"Popularised the skinny menswear silhouette during his Dior Homme years.","sourceIds":["s9"]}}]},
    {"id":"yves-saint-laurent","kind":"designer","name":"Yves Saint Laurent","aliases":["Yves Henri Donat Mathieu-Saint-Laurent"],"summary":{"text":"Algerian-born French couturier who took over Dior at 21, founded his own house in 1961 and put women in the tuxedo.","sourceIds":["s19","s64"]},"facts":[{"key":"born","claim":{"text":"Born 1 August 1936 in Oran, Algeria.","sourceIds":["s19"]}},{"key":"died","claim":{"text":"Died 1 June 2008 in Paris.","sourceIds":["s19"]}},{"key":"signature","claim":{"text":"Introduced Le Smoking, the women's tuxedo, in 1966.","sourceIds":["s20"]}}]},
    {"id":"alessandro-michele","kind":"designer","name":"Alessandro Michele","aliases":[],"summary":{"text":"Roman designer whose maximalist, eclectic Gucci ran from 2015 to 2022 before he moved to Valentino in 2024.","sourceIds":["s21","s22"]},"facts":[{"key":"nationality","claim":{"text":"Italian.","sourceIds":["s21"]}},{"key":"born","claim":{"text":"Born 25 November 1972 in Rome.","sourceIds":["s21"]}}]},
    {"id":"sabato-de-sarno","kind":"designer","name":"Sabato De Sarno","aliases":[],"summary":{"text":"Italian designer who rose to fashion director at Valentino and held his first creative-director post at Gucci from 2023 to 2025.","sourceIds":["s26","s24"]},"facts":[{"key":"nationality","claim":{"text":"Italian.","sourceIds":["s26"]}},{"key":"born","claim":{"text":"Born 1983.","sourceIds":["s26"]}},{"key":"career","claim":{"text":"Spent more than a decade at Valentino, ending as fashion director over men's and women's collections.","sourceIds":["s26"]}}]},
    {"id":"demna","kind":"designer","name":"Demna","aliases":["Demna Gvasalia"],"summary":{"text":"Georgian designer who spent a decade reshaping Balenciaga before Kering moved him to Gucci as artistic director in 2025.","sourceIds":["s27","s28"]},"facts":[{"key":"nationality","claim":{"text":"Georgian.","sourceIds":["s28"]}},{"key":"born","claim":{"text":"Born 1981 in Georgia.","sourceIds":["s28"]}},{"key":"career","claim":{"text":"Closed his Balenciaga tenure with a haute couture show on 9 July 2025.","sourceIds":["s29"]}}]},
    {"id":"frida-giannini","kind":"designer","name":"Frida Giannini","aliases":[],"summary":{"text":"Roman designer who rose from Gucci's handbag studio to creative director of the whole house, leaving in early 2015.","sourceIds":["s30","s31"]},"facts":[{"key":"nationality","claim":{"text":"Italian.","sourceIds":["s66"]}},{"key":"born","claim":{"text":"Born 1972 in Rome.","sourceIds":["s66"]}},{"key":"career","claim":{"text":"Joined Gucci in 2002 as director of handbag design.","sourceIds":["s30"]}}]},
    {"id":"anthony-vaccarello","kind":"designer","name":"Anthony Vaccarello","aliases":[],"summary":{"text":"Brussels-born designer of Italian parentage who has led Saint Laurent since April 2016 after a stint at Versus Versace.","sourceIds":["s12","s32"]},"facts":[{"key":"nationality","claim":{"text":"Belgian, born to Italian parents.","sourceIds":["s32"]}},{"key":"born","claim":{"text":"Born 18 January 1982 in Brussels.","sourceIds":["s32"]}},{"key":"career","claim":{"text":"First Saint Laurent collection shown October 2016 for spring 2017.","sourceIds":["s12"]}}]},
    {"id":"stefano-pilati","kind":"designer","name":"Stefano Pilati","aliases":[],"summary":{"text":"Milanese designer who succeeded Tom Ford at Yves Saint Laurent in 2004 and later led design at Ermenegildo Zegna.","sourceIds":["s33"]},"facts":[{"key":"nationality","claim":{"text":"Italian.","sourceIds":["s34"]}},{"key":"born","claim":{"text":"Born 10 December 1965 in Milan.","sourceIds":["s34"]}},{"key":"signature","claim":{"text":"Known at YSL for the Muse bag and tulip skirts.","sourceIds":["s33"]}}]},
    {"id":"phoebe-philo","kind":"designer","name":"Phoebe Philo","aliases":[],"summary":{"text":"British designer whose minimalist Céline defined 2010s womenswear; she returned in 2023 with an LVMH-backed label under her own name.","sourceIds":["s36","s37"]},"facts":[{"key":"nationality","claim":{"text":"British, born in Paris and raised in London.","sourceIds":["s36"]}},{"key":"born","claim":{"text":"Born 25 October 1973 in Paris.","sourceIds":["s36"]}},{"key":"career","claim":{"text":"Her own label launched in October 2023 with a minority LVMH stake.","sourceIds":["s37"]}}]},
    {"id":"michael-rider","kind":"designer","name":"Michael Rider","aliases":[],"summary":{"text":"Designer who spent a decade under Phoebe Philo at Celine and led Polo Ralph Lauren before returning to Celine as creative director.","sourceIds":["s38","s13"]},"facts":[{"key":"career","claim":{"text":"Began at Balenciaga under Nicolas Ghesquière, 2004–2008.","sourceIds":["s38"]}},{"key":"debut","claim":{"text":"Debut Celine runway show held 6 July 2025.","sourceIds":["s15"]}}]},
    {"id":"maria-grazia-chiuri","kind":"designer","name":"Maria Grazia Chiuri","aliases":[],"summary":{"text":"Roman designer who became Dior's first female creative director in 2016 and was named Fendi's chief creative officer in October 2025.","sourceIds":["s40","s41"]},"facts":[{"key":"nationality","claim":{"text":"Italian.","sourceIds":["s42"]}},{"key":"born","claim":{"text":"Born 2 February 1964 in Rome.","sourceIds":["s42"]}},{"key":"career","claim":{"text":"Spent 17 years at Valentino, eight of them at the creative helm with Pierpaolo Piccioli.","sourceIds":["s40"]}}]},
    {"id":"jonathan-anderson","kind":"designer","name":"Jonathan Anderson","aliases":["JW Anderson"],"summary":{"text":"Northern Irish designer who ran Loewe for eleven years and in 2025 became the first since Christian Dior to lead all Dior lines.","sourceIds":["s43","s44"]},"facts":[{"key":"nationality","claim":{"text":"Northern Irish.","sourceIds":["s44"]}},{"key":"born","claim":{"text":"Born 1984.","sourceIds":["s44"]}},{"key":"career","claim":{"text":"Launched the JW Anderson label in 2008.","sourceIds":["s44"]}}]},
    {"id":"kim-jones","kind":"designer","name":"Kim Jones","aliases":[],"summary":{"text":"English designer who fused streetwear and luxury at Louis Vuitton, led Dior Men for seven years and Fendi womenswear for four.","sourceIds":["s46","s47"]},"facts":[{"key":"nationality","claim":{"text":"English.","sourceIds":["s47"]}},{"key":"born","claim":{"text":"Born 11 September 1973 in London.","sourceIds":["s47"]}},{"key":"signature","claim":{"text":"Brought the Supreme collaboration to Louis Vuitton menswear.","sourceIds":["s47"]}}]},
