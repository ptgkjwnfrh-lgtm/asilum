    {"id":"saint-laurent","kind":"house","name":"Saint Laurent","aliases":["Yves Saint Laurent","YSL","Saint Laurent Paris","YSL Rive Gauche"],"catalogBrands":["Saint Laurent","Yves Saint Laurent"],"summary":{"text":"Paris house founded in 1961 by Yves Saint Laurent and Pierre Bergé; its ready-to-wear was rebranded Saint Laurent Paris in 2012.","sourceIds":["s20","s19"]},"facts":[{"key":"founded","claim":{"text":"Founded 1961 in Paris by Yves Saint Laurent with Pierre Bergé.","sourceIds":["s19","s20"]}},{"key":"rename","claim":{"text":"In 2012, under Hedi Slimane, the ready-to-wear line was renamed Saint Laurent Paris while YSL branding stayed on accessories and beauty.","sourceIds":["s20","s9"]}},{"key":"couture","claim":{"text":"The haute couture division closed in 2002.","sourceIds":["s20"]}}]},
