    {"id":"raf-simons","kind":"designer","name":"Raf Simons","aliases":["Raf Jan Simons"],"summary":{"text":"Belgian designer who moved from Jil Sander to Dior to Calvin Klein and since 2020 co-directs Prada with Miuccia Prada.","sourceIds":["s50","s52"]},"facts":[{"key":"nationality","claim":{"text":"Belgian.","sourceIds":["s53"]}},{"key":"born","claim":{"text":"Born 12 January 1968 in Neerpelt, Belgium.","sourceIds":["s53"]}},{"key":"career","claim":{"text":"First Dior collection shown July 2012.","sourceIds":["s50"]}}]},
    {"id":"haider-ackermann","kind":"designer","name":"Haider Ackermann","aliases":[],"summary":{"text":"Colombian-born French designer known for fluid tailoring, who led Berluti briefly and became Tom Ford's creative director in 2024.","sourceIds":["s7","s55"]},"facts":[{"key":"nationality","claim":{"text":"Colombian-born French.","sourceIds":["s55"]}},{"key":"born","claim":{"text":"Born 29 March 1971 in Bogotá.","sourceIds":["s55"]}},{"key":"career","claim":{"text":"First Tom Ford collection scheduled for Paris Fashion Week, March 2025.","sourceIds":["s7"]}}]},
